#include <stdio.h>
#include <stdlib.h>
#include <string.h>

typedef struct Node {
    char name[50];
    int id;
    float gpa;
    struct Node* next;
} Node;

Node* head = NULL;

Node* createNode(char *name, int id, float gpa){
    Node* n = (Node*)malloc(sizeof(Node));
    strcpy(n->name, name); n->id=id; n->gpa=gpa; n->next=NULL;
    return n;
}

void insertAtEnd(char *name, int id, float gpa){
    Node* newNode = createNode(name, id, gpa);
    if(head==NULL){ head=newNode; return; }
    Node* temp=head;
    while(temp->next!=NULL) temp=temp->next;
    temp->next=newNode;
}

void deleteById(int id){
    Node *temp=head, *prev=NULL;
    while(temp!=NULL && temp->id!=id){ prev=temp; temp=temp->next; }
    if(temp==NULL){ printf("Not found\n"); return; }
    if(prev==NULL) head=temp->next;
    else prev->next=temp->next;
    free(temp);
    printf("Deleted\n");
}

void display(){
    Node* temp=head;
    while(temp!=NULL){
        printf("[%d %s GPA:%.2f] -> ", temp->id, temp->name, temp->gpa);
        temp=temp->next;
    }
    printf("NULL\n");
}

int main(){
    insertAtEnd("Ian", 101, 3.8);
    insertAtEnd("Brian", 102, 3.5);
    insertAtEnd("Mercy", 103, 3.9);
    display();
    deleteById(102);
    display();
    return 0;
}